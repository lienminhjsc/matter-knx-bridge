{
  "name": "matter-knx-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge Matter devices (via matterjs-server) to KNX as a KNXnet/IP tunnelling interface, with an admin web app",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "matter-server": "matter-server",
    "build:admin": "vite build --config admin-ui/vite.config.ts",
    "dev:admin": "vite --config admin-ui/vite.config.ts",
    "typecheck:admin": "tsc -p admin-ui/tsconfig.json",
    "set-unlock-pin": "node scripts/set-unlock-pin.ts"
  },
  "dependencies": {
    "@matter-server/ws-client": "1.5.5",
    "matter-server": "1.5.5"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
